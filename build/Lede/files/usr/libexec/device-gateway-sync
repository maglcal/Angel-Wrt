#!/bin/sh
# device-gateway-sync — 按设备下发固定 IPv4 / 网关 / DNS（Angel-Wrt 自研实现）
#
# 设计：读取 /etc/config/device-gateway 的设备规则，生成 dnsmasq 配置片段到
#       /tmp/dnsmasq.d/device-gateway.conf（固件 dnsmasq 默认 confdir，且在 procd jail 挂载内）。
#       全程不修改 /etc/config/dhcp —— 系统 DHCP 静态租约、LuCI DHCP 页面、angel-mode 切换互不干扰。
# 安全：flock 互斥；IP/MAC/网关/DNS 严格校验；静态租约冲突检测；dnsmasq --test 语法校验；
#       原子发布；重启失败自动回滚上一份 conf。

CONFDIR='/tmp/dnsmasq.d'
CONF="${CONFDIR}/device-gateway.conf"
STATUS='/tmp/device-gateway.status'
LOCK='/tmp/device-gateway.lock'
CONFIG='device-gateway'

export PATH='/usr/sbin:/usr/bin:/sbin:/bin'
set -f

status() {
	_msg="$1"
	logger -t device-gateway "$_msg" 2>/dev/null
	{ date '+%F %T' | tr -d '\n'; printf ' %s\n' "$_msg"; } > "${STATUS}.tmp" 2>/dev/null && \
		mv -f "${STATUS}.tmp" "$STATUS" 2>/dev/null
}

die() { status "错误：$1"; exit 1; }

# ---- 互斥锁：首次进入时 flock 重入，保证同一时刻只有一个同步进程写 conf ----
if [ "${DG_LOCKED:-0}" != '1' ]; then
	DG_LOCKED=1
	export DG_LOCKED
	exec flock -x "$LOCK" "$0" "$@"
fi

# ---- 校验函数 ----
ip_ok() {
	awk -v ip="$1" 'BEGIN {
		n = split(ip, a, ".")
		if (n != 4) exit 1
		for (i = 1; i <= 4; i++) {
			if (a[i] !~ /^[0-9]+$/) exit 1
			if (a[i] + 0 > 255) exit 1
		}
		exit 0
	}'
}

mac_ok() { printf '%s\n' "$1" | grep -Eiq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; }

# 网关：空/inherit 表示继承（不下发 option 3）；否则必须是合法 IPv4
resolve_gateway() {
	_mode="$(uci -q get "${CONFIG}.$1.gateway_mode")"
	case "$_mode" in
		''|inherit) _gw='' ;;
		custom) _gw="$(uci -q get "${CONFIG}.$1.gateway")" ;;
		gw_main) _gw='10.0.0.1' ;;
		gw_bypass) _gw='10.0.0.2' ;;
		*)
			# 自定义网关预设：LuCI 生成的匿名段名（如 cfgxxxxxx），从 gateway_preset 段读 address
			[ "$(uci -q get "${CONFIG}.${_mode}")" = 'gateway_preset' ] || return 1
			_gw="$(uci -q get "${CONFIG}.${_mode}.address")" ;;
	esac
	[ -z "$_gw" ] || ip_ok "$_gw" || return 1
	printf '%s' "$_gw"
}

# DNS：输出逗号分隔的 IPv4 列表；空/inherit 表示继承（不下发 option 6）
resolve_dns() {
	_mode="$(uci -q get "${CONFIG}.$1.dns_mode")"
	case "$_mode" in
		''|inherit) _dns='' ;;
		ali) _dns='223.5.5.5,223.6.6.6' ;;
		tencent) _dns='119.29.29.29' ;;
		'114') _dns='114.114.114.114' ;;
		custom) _dns="$(uci -q get "${CONFIG}.$1.dns")" ;;
		*) return 1 ;;
	esac
	if [ -n "$_dns" ]; then
		# 逐项校验，逗号分隔
		_oldifs="$IFS"; IFS=,; set -- $_dns; IFS="$_oldifs"
		for _d in "$@"; do ip_ok "$_d" || return 1; done
		_dns="$(printf '%s' "$_dns" | tr -d '[:space:]')"
	fi
	printf '%s' "$_dns"
}

# 收集 /etc/config/dhcp 里已有的静态租约 IP（避免与系统租约冲突）
existing_lease_ips() {
	uci -q show dhcp 2>/dev/null | grep -E '^dhcp\.[^.]+\.ip=' | \
		sed -E "s/^dhcp\.[^.]+\.ip='?([0-9][0-9.]*)'?$/\1/"
}

# ---- --disable：清理本插件生成的 conf 并重载 dnsmasq ----
if [ "${DG_DISABLE:-0}" = '1' ]; then
	[ ! -f "$CONF" ] || { rm -f "$CONF" && /etc/init.d/dnsmasq reload >/dev/null 2>&1; }
	status '插件已停用，配置片段已清理'
	exit 0
fi

_enabled="$(uci -q get "${CONFIG}.main.enabled")"
if [ "$_enabled" = '0' ]; then
	[ ! -f "$CONF" ] || { rm -f "$CONF" && /etc/init.d/dnsmasq reload >/dev/null 2>&1; }
	status '插件已关闭，配置片段已清理'
	exit 0
fi

# ---- 临时目录：先生成、校验，全部通过再原子发布 ----
WORK="$(mktemp -d /tmp/device-gateway.XXXXXX)" || die '无法创建临时目录'
NEW="${WORK}/device-gateway.conf"
PREV="${WORK}/previous.conf"
PUBLISHED=''
cleanup() {
	[ -z "$PUBLISHED" ] || rm -f "$PUBLISHED"
	rm -rf "$WORK"
}
trap cleanup EXIT
: > "$NEW" || die '无法创建临时配置'
[ ! -f "$CONF" ] || cp -p "$CONF" "$PREV"

# 已有静态租约 IP 列表
LEASE_IPS="$(existing_lease_ips)"
ip_in_leases() {
	[ -n "$LEASE_IPS" ] || return 1
	printf '%s\n' "$LEASE_IPS" | grep -Fxq "$1"
}

seen_macs=' '
seen_ips=' '
rule_count=0
for _s in $(uci -q show "$CONFIG" 2>/dev/null | sed -n "s/^${CONFIG}\.\([^.=]*\)=rule$/\1/p" | sort -u); do
	# 上面的 sed 已筛出 rule 类型段
	[ "$(uci -q get "${CONFIG}.${_s}.enabled")" = '0' ] && continue

	_mac="$(uci -q get "${CONFIG}.${_s}.mac")"
	_ip="$(uci -q get "${CONFIG}.${_s}.ip")"
	_gw="$(resolve_gateway "$_s")" || die "规则 ${_s} 的网关设置无效"
	_dns="$(resolve_dns "$_s")" || die "规则 ${_s} 的 DNS 设置无效"

	mac_ok "$_mac" || die "规则 ${_s} 的 MAC 无效：${_mac}"
	ip_ok "$_ip" || die "规则 ${_s} 的固定 IP 无效：${_ip}"
	mac_lc="$(printf '%s' "$_mac" | tr 'A-F' 'a-f')"
	case "$seen_macs" in *" $mac_lc "*) die "MAC 地址重复：$_mac" ;; esac
	case "$seen_ips" in *" $_ip "*) die "固定 IP 重复：$_ip" ;; esac
	seen_macs="${seen_macs}${mac_lc} "
	seen_ips="${seen_ips}${_ip} "
	ip_in_leases "$_ip" && die "$_ip 已被系统 DHCP 静态租约占用，请在原租约中调整"

	_tag="dg_$(printf '%s' "$mac_lc" | tr -d ':')"
	printf 'dhcp-host=%s,set:%s,%s\n' "$mac_lc" "$_tag" "$_ip" >> "$NEW"
	[ -z "$_gw" ] || printf 'dhcp-option=tag:%s,3,%s\n' "$_tag" "$_gw" >> "$NEW"
	[ -z "$_dns" ] || printf 'dhcp-option=tag:%s,6,%s\n' "$_tag" "$_dns" >> "$NEW"
	rule_count=$((rule_count + 1))
done

# 语法校验：用完整 dnsmasq --test 验证生成的配置
dnsmasq --test --conf-file="$NEW" >/dev/null 2>&1 || die '生成的配置未通过 dnsmasq 校验'

# 内容无变化则跳过重载
if [ -f "$CONF" ] && cmp -s "$NEW" "$CONF"; then
	status "同步完成，${rule_count} 条规则无变化"
	exit 0
fi

reload_dnsmasq() {
	/etc/init.d/dnsmasq restart >/dev/null 2>&1 || return 1
	# 等待 DHCP 端口真正监听（最多 5 秒）
	_a=0
	while [ "$_a" -lt 5 ]; do
		netstat -lnup 2>/dev/null | awk '$4 ~ /:67$/ && $NF ~ /dnsmasq/ { f=1 } END { exit !f }' && return 0
		sleep 1
		_a=$((_a + 1))
	done
	return 1
}

# 原子发布：先写临时文件再 mv（同一文件系统，/tmp 内），随后重载
PUBLISH="$(mktemp "${CONFDIR}/.device-gateway.XXXXXX")" || die '无法写入配置目录'
cp "$NEW" "$PUBLISH" && chmod 644 "$PUBLISH" && mv -f "$PUBLISH" "$CONF" || {
	rm -f "$PUBLISH"
	PUBLISHED=''
	die '无法发布配置'
}
PUBLISHED=''

if ! reload_dnsmasq; then
	# 回滚：恢复上一份 conf（或删除），再重载
	if [ -f "$PREV" ]; then
		cp -p "$PREV" "$CONF"
	else
		rm -f "$CONF"
	fi
	/etc/init.d/dnsmasq restart >/dev/null 2>&1
	die 'dnsmasq 启动失败，已回滚上一份配置'
fi

status "已加载 ${rule_count} 条设备规则，等待客户端续租"
exit 0
