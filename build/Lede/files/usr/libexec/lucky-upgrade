#!/bin/sh
# Lucky 大吉在线更新 —— 修复固件里 Lucky 内置“更新程序”失效的问题
# 根因（2026-11-27 实证）：作者把 3.8.1 等新版放在自建官网文件站 release.66666.host，
#       GitHub releases 只停在 3.5.0。Lucky 内置更新走官网，但下载/替换/重启链路失败，
#       表现为更新后整机 reboot 但版本仍是旧的；LuCI 侧原也无可更新入口。
# 方案：固件侧独立升级通道，双数据源：
#       ① 官网文件站 release.66666.host（国内直连，主源）——目录列表解析最新 vX.Y.Z，
#          下载 https://release.66666.host/v{ver}/{ver}_lucky/lucky_{ver}_Linux_{arch}.tar.gz
#       ② GitHub releases/latest（代理轮询兜底，版本可能滞后）
#       下载 → tar 校验 → 备份替换 /usr/bin/lucky → 重启服务；失败自动回滚，不 reboot 整机。
# 用法（输出单行 JSON，供 LuCI rpc 解析）：
#   lucky-upgrade check   查询最新版本  {"current":"3.5.0","latest":"3.8.1","update":true,"error":""}
#   lucky-upgrade do      执行升级      {"current":"3.5.0","latest":"3.8.1","installed":"3.8.1","error":""}

RELEASE_SITE="https://release.66666.host"
REPO_API="https://api.github.com/repos/gdy666/lucky/releases/latest"
WORKDIR="/tmp/lucky-upgrade"
BIN="/usr/bin/lucky"

# 单行 JSON 输出（error 为空串表示成功）
out_json() {
    printf '{"current":"%s","latest":"%s","installed":"%s","update":%s,"error":"%s"}\n' \
        "$1" "$2" "$3" "$4" "$(printf '%s' "$5" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\n\r')"
}

# 通道列表：优先读 /etc/openwrt_update 里烧死的 GITHUB_PROXY
proxy_list() {
    _gp="https://ghfast.top"
    [ -f /etc/openwrt_update ] && . /etc/openwrt_update 2>/dev/null
    for _p in "${GITHUB_PROXY:-$_gp}" "https://gh-proxy.com" "https://ghproxy.net" "https://gh.llkk.cc" ""; do
        printf '%s\n' "$_p"
    done
}

# fetch <url> <outfile>：单通道下载，非空即成功
fetch() {
    ( uclient-fetch --no-check-certificate --timeout=30 "$1" -O "$2" >/dev/null 2>&1 ) || \
    ( wget -q --no-check-certificate --timeout=30 -t 1 "$1" -O "$2" >/dev/null 2>&1 )
    [ -s "$2" ]
}

# 多通道拉取 releases/latest API 快照
api_fetch() {
    mkdir -p "$WORKDIR"
    for _p in $(proxy_list); do
        rm -f "$WORKDIR/api.json"
        [ -n "$_p" ] && _u="${_p}/${REPO_API}" || _u="${REPO_API}"
        fetch "$_u" "$WORKDIR/api.json" || continue
        grep -q '"tag_name"' "$WORKDIR/api.json" 2>/dev/null || continue
        return 0
    done
    return 1
}

# 当前安装版本（优先读二进制自身 -info 输出，升级后 opkg 记录不会变）
cur_version() {
    _v="$($BIN -info -cd /etc/lucky 2>/dev/null | sed -n 's/.*"Version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)"
    [ -n "$_v" ] && { echo "$_v"; return; }
    _v="$(opkg info lucky 2>/dev/null | sed -n "s/^Version: \([0-9][0-9.]*\).*/\1/p" | head -n 1)"
    echo "$_v"
}

# 官网版本检测：从文件站首页目录列表解析 ./vX.Y.Z/ 链接，取版本号最大的一个（国内直连，版本领先 GitHub）
# 结果写入 $WORKDIR/site_version，成功返回 0
site_fetch_version() {
    mkdir -p "$WORKDIR"
    fetch "$RELEASE_SITE/" "$WORKDIR/site_index.html" || return 1
    _v="$(sed -n 's/.*\.\/v\([0-9][0-9.]*\)\/.*/\1/p' "$WORKDIR/site_index.html" 2>/dev/null | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)"
    [ -n "$_v" ] || return 1
    printf '%s\n' "$_v" > "$WORKDIR/site_version"
    return 0
}

# 云端最新版本：优先官网（领先 GitHub），失败回退 GitHub tag_name
latest_version() {
    [ -s "$WORKDIR/site_version" ] && { cat "$WORKDIR/site_version"; return; }
    sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$WORKDIR/api.json" 2>/dev/null | head -n 1 | sed 's/^v//'
}

# 拉取云端版本信息：官网优先，GitHub 兜底（两者都失败才算失败）
fetch_version_info() {
    mkdir -p "$WORKDIR"
    rm -f "$WORKDIR/site_version"
    if site_fetch_version; then
        return 0
    fi
    api_fetch
}

# 版本比较：两者不同则返回 0（有更新）
ver_differs() {
    [ "$1" != "$2" ]
}

# Lucky 架构（优先用包自带的 luckyarch）
lucky_arch() {
    if [ -x /usr/bin/luckyarch ]; then
        /usr/bin/luckyarch 2>/dev/null | head -n 1
    else
        uname -m
    fi
}

# 下载指定版本二进制包：官网文件站直连优先（版本最新且国内可达），GitHub 代理轮询兜底
download_pkg() {
    _ver="$1"
    _arch="$(lucky_arch)"
    _asset="lucky_${_ver}_Linux_${_arch}.tar.gz"

    _try_url() {
        rm -rf "$WORKDIR/dl"
        mkdir -p "$WORKDIR/dl"
        fetch "$1" "$WORKDIR/dl/pkg.tar.gz" || return 1
        # 校验 tar 包内确有 lucky 可执行文件
        if tar -tzf "$WORKDIR/dl/pkg.tar.gz" 2>/dev/null | grep -q "lucky"; then
            return 0
        fi
        rm -f "$WORKDIR/dl/pkg.tar.gz"
        return 1
    }

    # ① 官网：{site}/v{ver}/{ver}_lucky/lucky_{ver}_Linux_{arch}.tar.gz
    _try_url "${RELEASE_SITE}/v${_ver}/${_ver}_lucky/${_asset}" && return 0
    # ② 官网备用镜像 lucky666.cn/release
    _try_url "https://lucky666.cn/release/v${_ver}/${_ver}_lucky/${_asset}" && return 0
    # ③ GitHub 代理轮询（版本若已在 GitHub 发布则可用）
    for _p in $(proxy_list); do
        [ -n "$_p" ] && _u="${_p}/https://github.com/gdy666/lucky/releases/download/v${_ver}/${_asset}" \
                     || _u="https://github.com/gdy666/lucky/releases/download/v${_ver}/${_asset}"
        _try_url "$_u" && return 0
    done
    return 1
}

do_upgrade() {
    _cur="$(cur_version)"
    if fetch_version_info; then
        _latest="$(latest_version)"
    else
        out_json "$_cur" "" "" false "无法获取云端版本(所有通道失败)"
        return 1
    fi
    if [ -z "$_latest" ]; then
        out_json "$_cur" "" "" false "云端版本解析失败"
        return 1
    fi
    if ver_differs "$_cur" "$_latest"; then
        if download_pkg "$_latest"; then
            tar -xzf "$WORKDIR/dl/pkg.tar.gz" -C "$WORKDIR/dl" 2>/dev/null
            _newbin="$(find "$WORKDIR/dl" -maxdepth 3 -type f -name lucky 2>/dev/null | head -n 1)"
            if [ -z "$_newbin" ]; then
                out_json "$_cur" "$_latest" "" false "压缩包内未找到 lucky 二进制"
                return 1
            fi
            chmod 755 "$_newbin"
            cp -f "$BIN" "$BIN.bak" 2>/dev/null
            if ! cp -f "$_newbin" "$BIN.new" 2>/dev/null; then
                out_json "$_cur" "$_latest" "" false "写入 /usr/bin/lucky.new 失败(空间不足?)"
                return 1
            fi
            mv -f "$BIN.new" "$BIN"
            /etc/init.d/lucky restart >/dev/null 2>&1
            sleep 2
            _chk="$($BIN -info -cd /etc/lucky 2>/dev/null | head -c 1)"
            if [ -z "$_chk" ]; then
                # 新二进制起不来，回滚
                [ -f "$BIN.bak" ] && mv -f "$BIN.bak" "$BIN" && /etc/init.d/lucky restart >/dev/null 2>&1
                out_json "$_cur" "$_latest" "" false "新版本启动校验失败，已回滚"
                return 1
            fi
            rm -rf "$WORKDIR"
            out_json "$_cur" "$_latest" "$_latest" true ""
            return 0
        else
            out_json "$_cur" "$_latest" "" false "下载失败(所有通道)"
            return 1
        fi
    else
        rm -rf "$WORKDIR"
        out_json "$_cur" "$_latest" "$_cur" false "已是最新版本"
        return 0
    fi
}

do_check() {
    _cur="$(cur_version)"
    if fetch_version_info; then
        _latest="$(latest_version)"
        if [ -z "$_latest" ]; then
            out_json "$_cur" "" "" false "云端版本解析失败"
            return 1
        fi
        if ver_differs "$_cur" "$_latest"; then
            out_json "$_cur" "$_latest" "" true ""
        else
            out_json "$_cur" "$_latest" "" false ""
        fi
        return 0
    fi
    out_json "$_cur" "" "" false "无法获取云端版本(所有通道失败)"
    return 1
}

case "$1" in
    check) do_check ;;
    do)    do_upgrade ;;
    *)     echo "usage: lucky-upgrade check|do" >&2; exit 2 ;;
esac
