#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

# picoclaw-launcher 自动拉起 gateway 子进程并托管 Web 面板；
# 配置/工作目录通过 PICOCLAW_HOME 定向到 /etc/picoclaw。
start_service() {
	local enabled port home
	config_load picoclaw
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get port main port 18800
	config_get home main home /etc/picoclaw
	mkdir -p "$home"

	procd_open_instance
	procd_set_param command /usr/bin/picoclaw-launcher -no-browser -console -port "$port" -host 0.0.0.0
	procd_set_param env PICOCLAW_HOME="$home"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
