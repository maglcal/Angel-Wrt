#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

# SongLoft 以工作目录方式运行：配置 son.json、数据库 songloft.db
# 均落盘在 workdir 下（data/ 数据目录 + music/ 曲库目录）。
# Web 界面固定监听 58091。
start_service() {
	local enabled workdir
	config_load songloft
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get workdir main workdir /etc/songloft
	mkdir -p "$workdir/data" "$workdir/music"

	procd_open_instance
	procd_set_param command /bin/sh -c "cd '$workdir' && exec /usr/bin/songloft"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
